FROM node:16@sha256:f77a1aef2da8d83e45ec990f45df50f1a286c5fe8bbfb8c6e4246c6389705c0b

ARG BUILD_REPOSITORIES_PATH=./repositories

WORKDIR /app

# copy shared files and install dependencies
COPY /packages /packages
RUN cd /packages/interkit && npm ci && npm cache clean --force

# install dependencies
COPY ./app-bundler/package*json ./
#RUN npm i @node-rs/bcrypt-linux-musl
#RUN apt-get update && apt-get install musl
RUN npm ci && npm prune && npm cache clean --force
#RUN npx node-prune --yes

# copy app files
COPY ./app-bundler ./

# copy shared files AGAIN for starters
# link cp -r /packages /var/packages 
RUN ln -s /packages /var/packages

# set repositories path in container
ENV REPOSITORIES_PATH=/var/repositories
# Copy repositories folder
COPY ${BUILD_REPOSITORIES_PATH} ${REPOSITORIES_PATH}
# set REPOSITORIES_PATH at runtime
RUN echo "REPOSITORIES_PATH=${REPOSITORIES_PATH}" > .env

# npm install starter
# RUN cd ${REPOSITORIES_PATH}/starters/starter && npm ci


# remove all translations except en_US.UTF-8
# RUN rm -rf /usr/share/locale/*
# remove build tools
# RUN apt-get remove -y gcc g++ make python && apt-get autoremove -y && apt-get clean -y && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*


CMD ["npm", "start"]
